# ============================================================
# Advanced Tasks Supervisor — environment template (WEB)
# Copy to apps/web/.env.local and fill real values.
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time.
# ============================================================

# Base URL of the API deployed on Railway. NO trailing slash.
# Production example: https://ats-api-production.up.railway.app
# Local dev: http://localhost:4000
# Leave EMPTY to use same-origin "/api" (when the API is proxied behind the same domain).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public app URL (used in emails coming from the API and in sitemap/robots).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
