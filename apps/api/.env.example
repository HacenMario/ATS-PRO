# ============================================================
# Advanced Tasks Supervisor — environment template (API)
# Copy to apps/api/.env and fill real values. NEVER commit .env.
# ============================================================

# --- Node environment ---
NODE_ENV=development
PORT=4000

# --- MongoDB ---
# Local dev:  mongodb://127.0.0.1:27017/ats
# Production: mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ats

# --- Security / sessions ---
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_random_64_chars_minimum_secret_value_for_access_tokens
JWT_REFRESH_SECRET=CHANGE_ME_different_random_64_chars_minimum_secret_value_for_refresh_tokens
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins (NO trailing slash).
# Vercel domain first; add custom domains. Use http://localhost:3000 for local dev.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Set to "true" ONLY behind an HTTPS terminator (Vercel/Railway/Atlas).
COOKIE_SECURE=true
# Set to "true" when frontend and API are on different registrable domains
# (e.g. vercel.app + railway.app dev URLs). Keep "false" when using
# app.example.com + api.example.com (same site) for stronger CSRF isolation.
COOKIE_CROSS_SITE=false

# --- Super Admin bootstrap (used ONLY at first startup) ---
# Password must be >= 12 chars with upper, lower, digit and symbol.
# NOTE: quote the value (or avoid '#') — unquoted '#' starts a comment in .env files.
# There is NO default: the service refuses to create the account from weak/missing values.
SUPER_ADMIN_EMAIL=admin@your-domain.example
SUPER_ADMIN_PASSWORD=
# Optional alternative to SUPER_ADMIN_PASSWORD: path to a readable file containing the password.
# SUPER_ADMIN_PASSWORD_FILE=/run/secrets/super_admin_password

# --- Web Push (VAPID) ---
# Generate once: npm run vapid:generate --workspace @ats/api
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example

# --- Optional: SMTP for password-reset emails ---
# If left empty, password recovery falls back to the Super Admin panel
# (issue a one-time reset link) and the API explains that email is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Advanced Tasks Supervisor <no-reply@your-domain.example>"

# --- Frontend URL (used in emails / absolute links) ---
WEB_ORIGIN=https://your-app.vercel.app

# --- Uploads (GridFS) ---
MAX_UPLOAD_MB=4
MAX_FILES_PER_TASK=6
